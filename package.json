{
  "name": "maestro-personal-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:a": "VITE_APP_VARIANT=A vite",
    "dev:b": "VITE_APP_VARIANT=B vite",
    "dev:c": "VITE_APP_VARIANT=C vite",
    "build": "tsc && vite build",
    "build:a": "VITE_APP_VARIANT=A tsc && VITE_APP_VARIANT=A vite build",
    "build:b": "VITE_APP_VARIANT=B tsc && VITE_APP_VARIANT=B vite build",
    "build:c": "VITE_APP_VARIANT=C tsc && VITE_APP_VARIANT=C vite build",
    "preview": "vite preview",
    "preview:a": "VITE_APP_VARIANT=A vite preview",
    "preview:b": "VITE_APP_VARIANT=B vite preview",
    "preview:c": "VITE_APP_VARIANT=C vite preview",
    "check": "biome check --write && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && bun run check:static",
    "check:static": "bun run scripts/check-static-rules.ts",
    "test": "bunx vitest run",
    "test:unit": "bunx vitest run --project unit --project unit-ui",
    "test:integration": "bunx vitest run --project integration --project integration-ui",
    "test:e2e": "bunx playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@hookform/resolvers": "^7.0.6",
    "@ionic/react": "^9.0.11",
    "@ionic/react-router": "^9.0.11",
    "@microx-technologies/microform": "^2.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "ionicons": "^8.1.0",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7",
    "react-router": "^6.28.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
